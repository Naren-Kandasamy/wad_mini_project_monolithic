FROM quay.io/keycloak/keycloak:24.0

# Copy the pre-configured realm export containing roles, clients, and pre-seeded accounts
COPY infra/keycloak/realm-export.json /opt/keycloak/data/import/realm-export.json

# Default bootstrap credentials for admin console access
ENV KC_BOOTSTRAP_ADMIN_USERNAME=admin
ENV KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Enable HTTP behind SSL-terminating reverse proxies (Render, Railway, Fly.io)
ENV KC_HTTP_ENABLED=true
ENV KC_HOSTNAME_STRICT=false
ENV KC_PROXY_HEADERS=xforwarded

# Start Keycloak with auto-imported shopping-cart realm on port 8080
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start-dev", "--import-realm", "--http-port=8080"]
