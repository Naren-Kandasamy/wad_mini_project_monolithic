# ==========================================
# Comprehensive .gitignore for Shopping Cart Modular Monolith
# (Vue.js 3 + Spring Boot 4.1.1 / Java 21 + MongoDB + Keycloak)
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.secret
*credentials*
id_rsa*
auth.hash
recovery.hash

# ------------------------------------------
# Java & Maven
# ------------------------------------------
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------
# Node.js & Vue 3 Frontend
# ------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
.eslintcache
.stylelintcache

# ------------------------------------------
# Playwright & E2E Testing
# ------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/
e2e/test-results/
e2e/playwright-report/

# ------------------------------------------
# Local Databases & Docker Mounts
# ------------------------------------------
mongo-data/
keycloak-data/
data/
*.rdb

# ------------------------------------------
# IDEs & Text Editors
# ------------------------------------------
# JetBrains (IntelliJ IDEA)
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Generic Editors
*.swp
*.swo
*~
.#*
*.bak

# ------------------------------------------
# OS-Specific Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------
# Application Logs
# ------------------------------------------
*.log
logs/
backend/logs/

# ------------------------------------------
# External Skills & Tools
# ------------------------------------------
Docs/skills-main/
