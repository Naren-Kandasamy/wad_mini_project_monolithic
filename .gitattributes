# Auto-detect text files and normalize line endings
* text=auto

# Force LF on shell scripts (Linux, macOS, Git Bash, WSL)
*.sh text eol=lf

# Force CRLF on Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code files
*.java text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.md text eol=lf
