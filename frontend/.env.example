# ==============================================================================
# Aura & Earth Hardware Monolith — Frontend Environment Variables
# ==============================================================================

# Backend API Origin (leave blank for relative '/api' proxy or Vercel rewrite)
# For Render deployment: https://<your-render-app-name>.onrender.com
VITE_API_BASE_URL=

# Keycloak OIDC Realm URL (defaults to http://localhost:8180 for local docker dev)
# If left blank, the client automatically uses local resilient fallback authentication
VITE_KEYCLOAK_URL=
